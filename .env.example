DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

# Set via rails credentials:edit instead for production
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# NVIDIA NIM (OpenAI-compatible LLM). Optional: without a key, narasi sinyal &
# skor sentimen dilewati dan app jalan seperti biasa. Key gratis di build.nvidia.com.
NVIDIA_API_KEY=
# Fallback chain (comma-separated, urut prioritas). Kosongkan untuk pakai
# default: deepseek -> gpt-oss -> nemotron. Nemotron selalu jadi jaring
# pengaman terakhir. Model-ID = path di build.nvidia.com.
# NVIDIA_NIM_MODELS=deepseek-ai/deepseek-v4-pro,openai/gpt-oss-120b,nvidia/nemotron-3-ultra-550b-a55b
