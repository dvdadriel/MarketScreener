#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name "libjemalloc.so.2" -print -quit)
    export LD_PRELOAD
fi

# TIDAK db:prepare otomatis di sini: DATABASE_URL runtime adalah pooler
# Supabase (port 6543), yang tidak mendukung DDL/advisory lock. Migrasi
# harus dijalankan manual lewat direct URL (port 5432) — lihat
# docs/idx-screener-deploy-plan.md Fase 1.2.

exec "${@}"
